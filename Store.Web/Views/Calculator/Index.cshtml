@{
    ViewBag.Title = "Calculator";
}
<h2>@ViewBag.Title</h2>

@using (Html.BeginForm("Index", "Calculator", FormMethod.Post, new { @class = "form-inline" }))
{
    @Html.AntiForgeryToken()
    <div class="form-group">
        <input type="number" step="any" name="left" class="form-control" value="@ViewBag.Left" required />
    </div>
    <div class="form-group">
        <input type="number" step="any" name="right" class="form-control" value="@ViewBag.Right" required />
    </div>
    <button type="submit" class="btn btn-default">Calculate</button>
}

@if (ViewBag.Sum != null)
{
    <dl class="dl-horizontal">
        <dt>Sum</dt>
        <dd>@ViewBag.Sum</dd>
        <dt>Difference</dt>
        <dd>@ViewBag.Difference</dd>
    </dl>
}
